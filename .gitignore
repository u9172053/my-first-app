# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma sqlite (dev only)
/dev.db
/dev.db-journal
/prisma/dev.db
/prisma/dev.db-journal

# prisma init が生成するAIエージェント向け補助ドキュメント（アプリ本体とは無関係）
/.claude/skills/
/.windsurf/skills/
/.agents/skills/
/skills-lock.json
